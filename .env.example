# -----------------------------------------------------------------------------
# Wevnix environment variables
# Copy this to .env.local and fill in values. Never commit .env.local.
# -----------------------------------------------------------------------------

# --- Auth ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Fallback admin credentials — used when Prisma isn't wired.
# Once you run `npm run db:seed`, these create the first User row.
ADMIN_EMAIL=admin@wevnix.com
ADMIN_PASSWORD=change-me-immediately

# --- Database (optional until you're ready to persist) ---
# DATABASE_URL=postgresql://user:pass@host:5432/wevnix

# --- Communication: WhatsApp ---
# Exposed to the client so the floating button can link to the right number.
# Override per-deploy without code changes.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000

# --- Communication: AI chatbot ---
# Without this, the chatbot runs in demo mode and returns a placeholder reply.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: notify ops when a visitor requests human handoff
# SLACK_HANDOFF_WEBHOOK=https://hooks.slack.com/services/...
# RESEND_API_KEY=

# --- Payments: SSLCOMMERZ (aggregator for bKash, Nagad, Rocket, cards) ---
# Get these by opening a merchant account at https://sslcommerz.com
# Uses sandbox automatically when NODE_ENV !== 'production' OR when
# SSLCOMMERZ_SANDBOX=true is set explicitly.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Domain availability API (optional) ---
# WHOIS_API_PROVIDER=whoisxml
# WHOIS_API_KEY=
