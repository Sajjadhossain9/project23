// Wevnix admin database schema
// Run: npx prisma generate && npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Auth
// -----------------------------------------------------------------------------

enum UserRole {
  admin
  editor
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         UserRole  @default(editor)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]
}

// Server-side sessions let us revoke a login on logout or password change
// without waiting for JWT expiry. Each row = one active login.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Pricing
// -----------------------------------------------------------------------------

enum PricingCategory {
  web
  hosting
  seo
  ai
}

enum BillingCycle {
  one_time @map("one-time")
  monthly
  yearly
}

model PricingPlan {
  id           String          @id @default(cuid())
  category     PricingCategory
  name         String
  tagline      String
  priceBdt     Int
  billingCycle BillingCycle    @default(one_time)
  features     String[]
  popular      Boolean         @default(false)
  active       Boolean         @default(true)
  order        Int             @default(0)
  customQuote  Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([category, active, order])
}

model PricingFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, order])
}

// -----------------------------------------------------------------------------
// Audit log
// -----------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// Chat — AI conversations with site visitors
// -----------------------------------------------------------------------------

enum ChatStatus {
  active       // Bot is handling it
  handoff      // Visitor asked for a human; awaiting admin reply
  closed       // Visitor left or admin closed it
}

enum MessageRole {
  user         // Visitor
  assistant    // Bot
  admin        // Human staff member (during handoff)
  system       // Internal system messages (e.g., "handoff requested")
}

model ChatConversation {
  id          String     @id @default(cuid())
  visitorId   String     // Client-generated UUID stored in localStorage
  status      ChatStatus @default(active)
  locale      String     @default("en")
  userAgent   String?
  ip          String?
  pagePath    String?    // Where the chat was opened
  handedOffAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  messages ChatMessage[]

  @@index([visitorId])
  @@index([status, updatedAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String           @db.Text
  // Optional structured metadata — captured tool calls, quick-reply selections, etc.
  meta           Json?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

// -----------------------------------------------------------------------------
// Payments
// -----------------------------------------------------------------------------

enum PaymentMethod {
  bkash
  nagad
  rocket
  card           // Visa/Mastercard via aggregator
  bank_transfer  // Manual — receipt uploaded, admin verifies
}

enum PaymentStatus {
  pending        // Created, user hasn't paid yet
  processing     // Gateway accepted; waiting for user to complete OTP / PIN
  succeeded      // Captured; admin should fulfill
  failed         // User cancelled, wrong PIN, insufficient funds, etc.
  refunded       // Admin refunded after capture
  expired        // Session timed out without completion
}

/**
 * A single attempt to collect money. An Order can have many Payments if the
 * customer retries after a failure. The most recent `succeeded` payment wins.
 */
model Payment {
  id              String        @id @default(cuid())

  // What's being paid for
  orderId         String?       // Nullable so one-off direct-invoice payments work
  order           Order?        @relation(fields: [orderId], references: [id])

  // How much
  amountBdt       Int           // Whole Taka
  currency        String        @default("BDT")

  // Which rail
  method          PaymentMethod
  gateway         String        // "sslcommerz", "bkash-direct", "aamarpay", etc.

  // Gateway identifiers
  gatewayRef      String?       @unique  // The gateway's own transaction ID (bKash trxID, SSL val_id)
  merchantInvoice String        @unique  // Our own reference sent to the gateway
  gatewayUrl      String?       // Redirect URL, stored so we can reuse on refresh

  status          PaymentStatus @default(pending)

  // Metadata — raw gateway response for debugging, signed payload, IP, etc.
  rawResponse     Json?
  failureReason   String?
  paidAt          DateTime?
  expiresAt       DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events          PaymentEvent[]

  @@index([orderId])
  @@index([status, createdAt])
}

/**
 * Append-only log of every state transition. Auditors love this, and it saves
 * you when you have to answer "what happened to payment xyz?" at 10pm.
 */
model PaymentEvent {
  id         String        @id @default(cuid())
  paymentId  String
  payment    Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  source     String        // "webhook" | "ipn" | "admin" | "return-url"
  payload    Json?         // Raw data that drove this transition
  createdAt  DateTime      @default(now())

  @@index([paymentId, createdAt])
}

/**
 * Orders tie together what the customer wants to buy with who they are and
 * the Payment row that collected the money. This is the single source of
 * truth for "did they pay for this plan?"
 */
enum OrderStatus {
  draft
  awaiting_payment
  paid
  cancelled
  fulfilled
}

model Order {
  id           String      @id @default(cuid())

  // What was bought
  planId       String?     // PricingPlan.id — nullable for custom quotes
  planSnapshot Json        // Frozen snapshot of plan at time of order (so admin edits don't rewrite history)
  amountBdt    Int
  currency     String      @default("BDT")

  // Who bought it
  customerName  String
  customerEmail String
  customerPhone String

  status       OrderStatus @default(draft)
  notes        String?     @db.Text

  payments     Payment[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([customerEmail])
}
